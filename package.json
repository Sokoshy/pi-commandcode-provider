{
	"name": "@sokoshy/pi-commandcode-provider",
	"version": "0.3.0-fork.1",
	"description": "Unofficial fork of the Command Code provider for pi: every model behind one key, with the model list read live from the Command Code API, and a Go-plan fallback transport",
	"author": "Sokoshy",
	"license": "Apache-2.0",
	"type": "module",
	"keywords": [
		"pi",
		"pi-package",
		"pi-extension",
		"command-code",
		"llm",
		"provider"
	],
	"homepage": "https://github.com/Sokoshy/pi-commandcode-provider",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Sokoshy/pi-commandcode-provider.git"
	},
	"bugs": {
		"url": "https://github.com/Sokoshy/pi-commandcode-provider/issues"
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"index.ts",
		"src/",
		"README.md",
		"LICENSE",
		"NOTICE"
	],
	"scripts": {
		"check": "tsc --noEmit",
		"test": "bun test.ts",
		"test:live": "bun test.ts --live"
	},
	"pi": {
		"extensions": [
			"./index.ts"
		]
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*"
	},
	"devDependencies": {
		"@earendil-works/pi-ai": "^0.86.0",
		"@earendil-works/pi-coding-agent": "^0.86.0",
		"@types/node": "^26.0.0",
		"typescript": "^5.9.3"
	}
}
